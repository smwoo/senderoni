        "journal_sent_boolean": {
          "name": "journal_sent_boolean",
          "value": "\"journal_entries\".\"sent\" IN (0, 1)"
        },
        "journal_training_shape": {
          "name": "journal_training_shape",
          "value": "\"journal_entries\".\"kind\" <> 'training' OR (\"journal_entries\".\"climb_id\" IS NULL AND \"journal_entries\".\"sent\" = 0)"
        },
        "journal_sent_needs_climb": {
          "name": "journal_sent_needs_climb",
          "value": "\"journal_entries\".\"sent\" = 0 OR \"journal_entries\".\"climb_id\" IS NOT NULL"
        },
        "journal_session_needs_climb": {
          "name": "journal_session_needs_climb",
