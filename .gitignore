# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Glob, not bare `.dev.vars`: wrangler's `--env` also reads .dev.vars.<env>
.dev.vars*
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# plan-mode snapshots
.plans

# wrangler / cloudflare
.wrangler
.open-next
worker-configuration.d.ts

# seed data
climbs_data

# Claude Code worktrees; the rest of .claude is shared config
.claude/worktrees/
# backfill script artifacts (generated SQL, rollback, review CSV)
backfill-out/
